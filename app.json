{
  "expo": {
    "name": "webdocs",
    "slug": "webdocs",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fefefe"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fefefe"
      },
      "package": "com.mynger.webdocs"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "mynger",
    "extra": {
      "eas": {
        "projectId": "8d981ef4-22fb-4854-973b-4c277c346dd6"
      }
    },
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#fefefe",
          "imageWidth": 200
        }
      ]
    ]
  }
}
